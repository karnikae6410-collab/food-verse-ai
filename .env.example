# Food Verse AI - Environment Configuration Example

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (MongoDB)
# If left empty or connection fails, the app automatically runs in resilient in-memory demo mode
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=food_verse_ai

# LLM Provider Configuration for AI Cooking Assistant & Meal Planner
# Options: none, gemini, openai, groq, ollama
# When set to 'none' or left blank, the app uses intelligent rule-based culinary fallbacks
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Vision & Model Provider Configuration
# Options: hybrid, local_cv, mock
VISION_MODEL_PROVIDER=hybrid
CONFIDENCE_THRESHOLD=0.60

# External Nutrition API (Optional - structured local dataset used by default)
# USDA_API_KEY=
# EDAMAM_APP_ID=
# EDAMAM_APP_KEY=

# File Upload Limits
MAX_UPLOAD_SIZE_MB=25
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime

# Frontend Configuration (used in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Food Verse AI
NEXT_PUBLIC_DEMO_MODE=true
